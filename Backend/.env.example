# Copie para .env e preencha. NUNCA versionar o .env.

# SQL Server (VM)
SQL_SERVER=192.168.0.10
SQL_PORT=1433
SQL_DATABASE=TicketInsight
SQL_USER=ticketinsight_app
SQL_PASSWORD=
SQL_ENCRYPT=false

# OpenAI
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# API
PORT=3001

# Limiares de confiança (similaridade de cosseno do melhor candidato)
# Calibrar com tickets reais — ver README, seção 6
CONF_ALTA=0.55
CONF_MEDIA=0.42
CONF_ABSTENCAO=0.32
